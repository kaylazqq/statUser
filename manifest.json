{
  "manifestVersion": "1.0.0",
  "name": "话题参与统计",
  "description": "统计当前话题的参与人数、发言 Agent 数和消息数量。使用方式：安装到项目后，打开任意话题，在话题标题右侧点击“参与统计”，即可查看该话题的实时统计结果。应用仅读取当前话题的成员和消息信息，不会修改或发送消息。",
  "tag": "App",
  "version": "1.0.2",
  "supportedInstallationScopes": ["project"],
  "permissions": ["messages:read", "users:read"],
  "ui": {
    "contractVersion": "1.0.0",
    "entries": [
      {
        "entryId": "topic-participant-stats",
        "extensionPoint": {
          "id": "colink.topic.actions",
          "version": "1.0.0"
        },
        "label": "参与统计",
        "openView": {
          "viewId": "topic-participant-stats-dialog",
          "container": "modal_dialog"
        }
      }
    ],
    "views": [
      {
        "viewId": "topic-participant-stats-dialog",
        "renderer": "app",
        "entryPath": "/index.html",
        "bridgeVersion": "1.0.0"
      }
    ]
  }
}
